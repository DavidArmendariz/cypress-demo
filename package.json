{
  "name": "cypress-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reference project: Cypress best practices for an auth-gated app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "ENABLE_TEST_ROUTES=1 BCRYPT_ROUNDS=4 tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p cypress/tsconfig.json",
    "cy:open": "cypress open --e2e",
    "cy:open:ct": "cypress open --component",
    "cy:run": "cypress run --e2e",
    "cy:run:ct": "cypress run --component",
    "test:e2e": "start-server-and-test dev \"http://localhost:5180|http://localhost:3001/api/health\" cy:run",
    "test:open": "start-server-and-test dev \"http://localhost:5180|http://localhost:3001/api/health\" cy:open"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/cypress": "^10.1.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "cypress": "^15.20.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.8.1",
    "eslint-plugin-cypress": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.11.0",
    "start-server-and-test": "^3.0.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
